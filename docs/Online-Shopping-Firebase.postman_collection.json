              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.6 Cash orders between dates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}:runQuery?key={{apiKey}}",
            "description": "Equality + range filter needs a COMPOSITE INDEX. The first time, Firestore returns an error with a link: open it, click Create index, wait ~1 minute, run again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [\n      {\n        \"collectionId\": \"orders\"\n      }\n    ],\n    \"where\": {\n      \"compositeFilter\": {\n        \"op\": \"AND\",\n        \"filters\": [\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"paymentType\"\n              },\n              \"op\": \"EQUAL\",\n              \"value\": {\n                \"stringValue\": \"cash\"\n              }\n            }\n          },\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"createdAt\"\n              },\n              \"op\": \"GREATER_THAN_OR_EQUAL\",\n              \"value\": {\n                \"timestampValue\": \"{{fromDate}}\"\n              }\n            }\n          },\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"createdAt\"\n              },\n              \"op\": \"LESS_THAN_OR_EQUAL\",\n              \"value\": {\n                \"timestampValue\": \"{{toDate}}\"\n              }\n            }\n          }\n        ]\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
