{
  "info": {
    "name": "Online Shopping - Firebase REST API",
    "description": "Backend tests for the Online Shopping assignment (Firestore REST + Firebase Auth REST). Run the folders in order. Variables are under the collection's Variables tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Sign up (new customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/accounts:signUp?key={{apiKey}}",
            "description": "Creates a Firebase Auth user. Saves idToken, refreshToken and uid into collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"returnSecureToken\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('idToken', r.idToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "pm.collectionVariables.set('uid', r.localId);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Sign in (customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
