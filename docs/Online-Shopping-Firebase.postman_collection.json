        {
          "name": "3.3 List items, page 1 (pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory?pageSize=5&orderBy=title&key={{apiKey}}",
            "description": "Returns 5 items and a nextPageToken if more exist."
