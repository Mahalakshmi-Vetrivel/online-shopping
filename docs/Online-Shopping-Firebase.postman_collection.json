    {
      "name": "5. Orders & Reports",
      "item": [
        {
          "name": "5.1 Place order - CASH (atomic commit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}:commit?key={{apiKey}}",
            "description": "ONE atomic request: creates the order AND reduces stock. Either both happen or neither.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"writes\": [\n    {\n      \"update\": {\n        \"name\": \"projects/{{projectId}}/databases/(default)/documents/orders/{{orderId}}\",\n        \"fields\": {\n          \"customerId\": {\n            \"stringValue\": \"{{uid}}\"\n          },\n          \"customerName\": {\n            \"stringValue\": \"Test Customer\"\n          },\n          \"customerEmail\": {\n            \"stringValue\": \"{{customerEmail}}\"\n          },\n          \"items\": {\n            \"arrayValue\": {\n              \"values\": [\n                {\n                  \"mapValue\": {\n                    \"fields\": {\n                      \"productId\": {\n                        \"stringValue\": \"{{inventoryId}}\"\n                      },\n                      \"title\": {\n                        \"stringValue\": \"Wireless Earbuds Pro\"\n                      },\n                      \"catId\": {\n                        \"stringValue\": \"{{categoryId}}\"\n                      },\n                      \"categoryName\": {\n                        \"stringValue\": \"Electronics\"\n                      },\n                      \"qty\": {\n                        \"integerValue\": \"2\"\n                      },\n                      \"price\": {\n                        \"doubleValue\": 1999.0\n                      },\n                      \"lineTotal\": {\n                        \"doubleValue\": 3998.0\n                      }\n                    }\n                  }\n                }\n              ]\n            }\n          },\n          \"totalAmount\": {\n            \"doubleValue\": 3998.0\n          },\n          \"paymentType\": {\n            \"stringValue\": \"cash\"\n          },\n          \"status\": {\n            \"stringValue\": \"PLACED\"\n          }\n        }\n      },\n      \"updateTransforms\": [\n        {\n          \"fieldPath\": \"createdAt\",\n          \"setToServerValue\": \"REQUEST_TIME\"\n        }\n      ],\n      \"currentDocument\": {\n        \"exists\": false\n      }\n    },\n    {\n      \"transform\": {\n        \"document\": \"projects/{{projectId}}/databases/(default)/documents/inventory/{{inventoryId}}\",\n        \"fieldTransforms\": [\n          {\n            \"fieldPath\": \"qty\",\n            \"increment\": {\n              \"integerValue\": \"-2\"\n            }\n          }\n        ]\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
