            ],
            "url": "{{baseUrl}}:commit?key={{apiKey}}",
            "description": "Creates the order, reduces stock AND adds to the customer's creditUsed. The app must check available credit (creditLimit - creditUsed) and stock BEFORE calling this.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"writes\": [\n    {\n      \"update\": {\n        \"name\": \"projects/{{projectId}}/databases/(default)/documents/orders/{{orderId}}\",\n        \"fields\": {\n          \"customerId\": {\n            \"stringValue\": \"{{uid}}\"\n          },\n          \"customerName\": {\n            \"stringValue\": \"Test Customer\"\n          },\n          \"customerEmail\": {\n            \"stringValue\": \"{{customerEmail}}\"\n          },\n          \"items\": {\n            \"arrayValue\": {\n              \"values\": [\n                {\n                  \"mapValue\": {\n                    \"fields\": {\n                      \"productId\": {\n                        \"stringValue\": \"{{inventoryId}}\"\n                      },\n                      \"title\": {\n                        \"stringValue\": \"Wireless Earbuds Pro\"\n                      },\n                      \"catId\": {\n                        \"stringValue\": \"{{categoryId}}\"\n                      },\n                      \"categoryName\": {\n                        \"stringValue\": \"Electronics\"\n                      },\n                      \"qty\": {\n                        \"integerValue\": \"1\"\n                      },\n                      \"price\": {\n                        \"doubleValue\": 999.0\n                      },\n                      \"lineTotal\": {\n                        \"doubleValue\": 999.0\n                      }\n                    }\n                  }\n                }\n              ]\n            }\n          },\n          \"totalAmount\": {\n            \"doubleValue\": 999.0\n          },\n          \"paymentType\": {\n            \"stringValue\": \"credit\"\n          },\n          \"status\": {\n            \"stringValue\": \"PLACED\"\n          }\n        }\n      },\n      \"updateTransforms\": [\n        {\n          \"fieldPath\": \"createdAt\",\n          \"setToServerValue\": \"REQUEST_TIME\"\n        }\n      ],\n      \"currentDocument\": {\n        \"exists\": false\n      }\n    },\n    {\n      \"transform\": {\n        \"document\": \"projects/{{projectId}}/databases/(default)/documents/inventory/{{inventoryId}}\",\n        \"fieldTransforms\": [\n          {\n            \"fieldPath\": \"qty\",\n            \"increment\": {\n              \"integerValue\": \"-1\"\n            }\n          }\n        ]\n      }\n    },\n    {\n      \"transform\": {\n        \"document\": \"projects/{{projectId}}/databases/(default)/documents/customers/{{uid}}\",\n        \"fieldTransforms\": [\n          {\n            \"fieldPath\": \"creditUsed\",\n            \"increment\": {\n              \"doubleValue\": 999.0\n            }\n          }\n        ]\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
