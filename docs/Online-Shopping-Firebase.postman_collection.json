          "name": "3.4 List items, next page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory?pageSize=5&orderBy=title&pageToken={{pageToken}}&key={{apiKey}}",
            "description": ""
