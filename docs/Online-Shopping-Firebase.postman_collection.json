        {
          "name": "3.5 Items by category (runQuery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}:runQuery?key={{apiKey}}",
            "description": "Filter by catId. Change offset (0, 5, 10...) for pages.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [\n      {\n        \"collectionId\": \"inventory\"\n      }\n    ],\n    \"where\": {\n      \"fieldFilter\": {\n        \"field\": {\n          \"fieldPath\": \"catId\"\n        },\n        \"op\": \"EQUAL\",\n        \"value\": {\n          \"stringValue\": \"{{categoryId}}\"\n        }\n      }\n    },\n    \"limit\": 5,\n    \"offset\": 0\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Search items by title prefix",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}:runQuery?key={{apiKey}}",
            "description": "Firestore has no 'contains' search; this is a prefix search (case-sensitive).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [\n      {\n        \"collectionId\": \"inventory\"\n      }\n    ],\n    \"where\": {\n      \"compositeFilter\": {\n        \"op\": \"AND\",\n        \"filters\": [\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"title\"\n              },\n              \"op\": \"GREATER_THAN_OR_EQUAL\",\n              \"value\": {\n                \"stringValue\": \"Wire\"\n              }\n            }\n          },\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"title\"\n              },\n              \"op\": \"LESS_THAN_OR_EQUAL\",\n              \"value\": {\n                \"stringValue\": \"Wire\\uf8ff\"\n              }\n            }\n          }\n        ]\n      }\n    },\n    \"limit\": 10\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.7 Update item (all fields except ID)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/inventory/{{inventoryId}}?updateMask.fieldPaths=title&updateMask.fieldPaths=description&updateMask.fieldPaths=qty&updateMask.fieldPaths=price&updateMask.fieldPaths=catId&updateMask.fieldPaths=categoryName&currentDocument.exists=true&key={{apiKey}}",
            "description": "updateMask = only these fields change. Without it, PATCH replaces the whole document!",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"title\": {\n      \"stringValue\": \"Wireless Earbuds Pro\"\n    },\n    \"description\": {\n      \"stringValue\": \"Noise cancelling, 36 hours battery\"\n    },\n    \"qty\": {\n      \"integerValue\": \"40\"\n    },\n    \"price\": {\n      \"doubleValue\": 1999.0\n    },\n    \"catId\": {\n      \"stringValue\": \"{{categoryId}}\"\n    },\n    \"categoryName\": {\n      \"stringValue\": \"Electronics\"\n    }\n  }\n}",
              "options": {
