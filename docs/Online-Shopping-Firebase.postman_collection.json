          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().nextPageToken || '';",
                  "pm.collectionVariables.set('pageToken', t);",
                  "pm.test('nextPageToken saved (empty = last page)', () => true);"
                ]
              }
            }
