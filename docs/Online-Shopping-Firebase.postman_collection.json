                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Refresh ID token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "https://securetoken.googleapis.com/v1/token?key={{apiKey}}",
            "description": "ID tokens expire after 1 hour. This gets a new one.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('idToken', r.id_token);",
                  "pm.collectionVariables.set('refreshToken', r.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Send password reset email",
