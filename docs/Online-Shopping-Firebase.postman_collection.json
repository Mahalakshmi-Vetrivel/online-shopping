        {
          "name": "5.5 All orders between dates (sales report)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}:runQuery?key={{apiKey}}",
            "description": "Uses fromDate / toDate variables (ISO format, e.g. 2026-11-01T00:00:00Z).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [\n      {\n        \"collectionId\": \"orders\"\n      }\n    ],\n    \"where\": {\n      \"compositeFilter\": {\n        \"op\": \"AND\",\n        \"filters\": [\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"createdAt\"\n              },\n              \"op\": \"GREATER_THAN_OR_EQUAL\",\n              \"value\": {\n                \"timestampValue\": \"{{fromDate}}\"\n              }\n            }\n          },\n          {\n            \"fieldFilter\": {\n              \"field\": {\n                \"fieldPath\": \"createdAt\"\n              },\n              \"op\": \"LESS_THAN_OR_EQUAL\",\n              \"value\": {\n                \"timestampValue\": \"{{toDate}}\"\n              }\n            }\n          }\n        ]\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
