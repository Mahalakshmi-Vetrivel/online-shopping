    {
      "name": "3. Inventory (Admin)",
      "item": [
        {
          "name": "3.1 Create item (auto ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/inventory?key={{apiKey}}",
            "description": "Admin creates a product. The new document ID is saved as inventoryId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"catId\": {\n      \"stringValue\": \"{{categoryId}}\"\n    },\n    \"categoryName\": {\n      \"stringValue\": \"Electronics\"\n    },\n    \"title\": {\n      \"stringValue\": \"Wireless Earbuds\"\n    },\n    \"description\": {\n      \"stringValue\": \"Bluetooth 5.3 earbuds with 30 hours of battery\"\n    },\n    \"qty\": {\n      \"integerValue\": \"50\"\n    },\n    \"price\": {\n      \"doubleValue\": 1499.0\n    },\n    \"isActive\": {\n      \"booleanValue\": true\n    },\n    \"createdAt\": {\n      \"timestampValue\": \"2026-11-20T10:00:00Z\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const id = pm.response.json().name.split('/').pop();",
                  "pm.collectionVariables.set('inventoryId', id);"
                ]
              }
            }
          ]
        },
