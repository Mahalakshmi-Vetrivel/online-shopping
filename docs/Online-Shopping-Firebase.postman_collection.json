        {
          "name": "1.4 Get signed-in user (lookup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/accounts:lookup?key={{apiKey}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{idToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
